#!/bin/bash
# После установки: снять карантин с установленной программы. Файлы из пакета его обычно и не получают,
# но тогда macOS не спросит про «неизвестного разработчика» и при копировании программы на другой Mac.
# Папку данных (~/Library/Application Support/LogAtlas) здесь не трогаем: скрипт работает от root и
# создал бы её с владельцем root — программа сама заводит её при первом запуске от имени пользователя.
APP="${3%/}/Applications/LogAtlas.app"
[ -d "$APP" ] || exit 0

xattr -dr com.apple.quarantine "$APP" >/dev/null 2>&1

# подпись ad-hoc: на Apple Silicon без неё программа не запустится вовсе — проверяем, что она цела
if ! codesign --verify "$APP" >/dev/null 2>&1; then
  echo "LogAtlas: подпись установленной программы не сходится" >&2
  exit 1
fi

exit 0
