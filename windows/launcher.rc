// Значок и сведения о версии для LogAtlas.exe (VERSION_* подставляет сборка, см. .github/workflows/windows.yml)
#include <winver.h>
#ifndef VERSION_NUM
#define VERSION_NUM 1,4,0,0
#define VERSION_STR "1.4.0"
#endif

1 ICON "logatlas.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUM
PRODUCTVERSION VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "ArsIS-02"
      VALUE "FileDescription", "LogAtlas"
      VALUE "FileVersion", VERSION_STR
      VALUE "InternalName", "LogAtlas"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "LogAtlas.exe"
      VALUE "ProductName", "LogAtlas"
      VALUE "ProductVersion", VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0419, 1200
  END
END
