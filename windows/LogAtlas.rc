// Ресурсы LogAtlas.exe: значок, манифест (DPI, стили окон), сведения о версии
#include <winver.h>
#include "version.h"

1 ICON "logatlas.ico"
1 24 "LogAtlas.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LOGATLAS_VERSION_NUM
PRODUCTVERSION LOGATLAS_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "ArsIS-02"
      VALUE "FileDescription", "LogAtlas"
      VALUE "FileVersion", LOGATLAS_VERSION_STR
      VALUE "InternalName", "LogAtlas"
      VALUE "LegalCopyright", "GPL-3.0 License"
      VALUE "OriginalFilename", "LogAtlas.exe"
      VALUE "ProductName", "LogAtlas"
      VALUE "ProductVersion", LOGATLAS_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0419, 1200
  END
END
